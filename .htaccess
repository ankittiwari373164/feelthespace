# BEGIN Remove HTML Extension
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Remove .html extension - allow access to files without .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/?$ $1.html [L]
  
  # Redirect .html requests to non-.html version
  RewriteCond %{THE_REQUEST} ^GET\ /+(.+?)\.html\ HTTP
  RewriteRule ^(.+?)\.html$ /$1 [R=301,L]
  
</IfModule>
# END Remove HTML Extension

# Prevent direct access to .html files with query strings
<IfModule mod_rewrite.c>
  RewriteCond %{QUERY_STRING} ^$
  RewriteRule ^(.*)\.html$ - [L]
</IfModule>

# Proper MIME types
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddEncoding gzip .svgz
</IfModule>

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 week"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

# Disable directory listing
Options -Indexes

# Security - prevent access to sensitive files
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
